# Postgres — required, used by both docker-compose and the server
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<database>

# Server — required
DATABASE_URL=postgres://<user>:<password>@localhost:5432/<database>  # constructed from POSTGRES_* above

# Server — optional, defaults shown
REDIS_URL=redis://localhost:6379
SERVER_HOST=127.0.0.1
PORT=3000
NDBC_DATA_TTL_HOURS=6
