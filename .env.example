# Postgres — required
# Used by docker-compose to initialise the database and by the server via DATABASE_URL
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=<database>

# Server — required
DATABASE_URL=postgres://<user>:<password>@localhost:5432/<database>
REDIS_URL=redis://localhost:6379

# Server — optional, defaults shown
SERVER_HOST=127.0.0.1
PORT=3000
NDBC_DATA_TTL_HOURS=6

# Auth — required in production
# AUTH_ENABLED=true requires JWT_SECRET and BETA_TOKENS to be set
AUTH_ENABLED=false
JWT_SECRET=<random-secret>
COOKIE_SECURE=false
# Format: [{"sub":"owner","role":"owner","token":"<secret>"},{"sub":"beta-jan-2027","role":"beta","token":"<secret>","expiresAt":"2027-01-31"}]
BETA_TOKENS=[]
